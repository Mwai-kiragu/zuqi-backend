{
  "title": "Zuqi AI — Model Health & Data Maturity",
  "uid": "zuqi-model-health",
  "description": "Data phase tracking (SYNTHETIC/HYBRID/REAL), confidence modifiers, and demand forecasting model performance metrics.",
  "tags": ["zuqi", "ai", "ml", "model"],
  "timezone": "browser",
  "refresh": "60s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Current Data Phase",
      "description": "Active data phase for AI models: SYNTHETIC (0), HYBRID (1), or REAL (2).",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "SYNTHETIC", "color": "orange" } } },
            { "type": "value", "options": { "1": { "text": "HYBRID",    "color": "blue"   } } },
            { "type": "value", "options": { "2": { "text": "REAL",      "color": "green"  } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "blue",   "value": 1    },
              { "color": "green",  "value": 2    }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_data_phase",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Real Data Ratio",
      "description": "Fraction of training data that comes from real (non-synthetic) observations (0.0 – 1.0).",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null  },
              { "color": "yellow", "value": 0.3   },
              { "color": "green",  "value": 0.8   }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_real_data_ratio",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Confidence Modifier",
      "description": "Current confidence multiplier applied at inference time (SYNTHETIC=0.6, HYBRID/REAL=1.0).",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "yellow", "value": 0.7  },
              { "color": "green",  "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_confidence_modifier",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Demand Model R²",
      "description": "Coefficient of determination for the active demand forecasting model (quality gate: R² ≥ 0.70).",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.5  },
              { "color": "green",  "value": 0.7  }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_model_r2_score{model_name=\"demand_forecaster\"}",
          "legendFormat": "demand_forecaster",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Real Data Ratio — History",
      "description": "How the share of real training data grows over time as merchants place actual orders.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_real_data_ratio",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Confidence Modifier — History",
      "description": "Confidence modifier value over time. Jumps from 0.6 → 1.0 when a model transitions out of SYNTHETIC phase.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green",  "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_confidence_modifier",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Model R² Score — History",
      "description": "R² quality metric tracked across weekly model retraining runs. Quality gate threshold is 0.70.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.5  },
              { "color": "green",  "value": 0.7  }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_model_r2_score",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Demand Forecast MAE & RMSE",
      "description": "Mean Absolute Error and Root Mean Squared Error for the demand forecasting model (lower is better, in order units).",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_model_mae{model_name=\"demand_forecaster\"}",
          "legendFormat": "MAE",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_model_rmse{model_name=\"demand_forecaster\"}",
          "legendFormat": "RMSE",
          "refId": "B"
        }
      ]
    },

    {
      "id": 9,
      "type": "bargauge",
      "title": "Synthetic Training Runs",
      "description": "Total number of completed synthetic data runs per model.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "zuqi_ai_synthetic_runs_total",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "piechart",
      "title": "Data Phase Distribution",
      "description": "How many models are currently in each data phase.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "list", "placement": "right" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "count by (phase) (zuqi_ai_data_phase)",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    }

  ]
}
